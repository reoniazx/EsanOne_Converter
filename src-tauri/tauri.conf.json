{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EsanOne Converter",
  "version": "0.1.1",
  "identifier": "com.esanone.convert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "showMenuOnLeftClick": false,
      "tooltip": "EsanOne Converter"
    },
    "windows": [
      {
        "label": "main",
        "title": "EsanOne Converter",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' asset: blob: data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/essentia/README.md",
      "resources/essentia/AGPL-3.0.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBMzVBNUZDNEY2NzJDRQpSV1RPY3ZiRVgxcWpEdEdSUHB5UzNrWk1TTVhZVEhFTXhzZi9pVElQckNLVm9vbjVVZk1pbkM3WAo=",
      "endpoints": [
        "https://github.com/reoniazx/EsanOne-Releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
